{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/listings/paradise-valley-estate", "destination": "/listings/20320-e-sunset-court", "permanent": true },
    { "source": "/listings/watford-court", "destination": "/listings/1823-e-watford-court", "permanent": true },
    { "source": "/listings/grayhawk-residence", "destination": "/listings/4020-n-scottsdale-road", "permanent": true },
    { "source": "/listings/old-town-residence", "destination": "/listings/7618-n-19th-drive", "permanent": true },
    { "source": "/listings/4020-n-scottsdale-road-2010", "destination": "/listings/4020-n-scottsdale-road", "permanent": true }
  ]
}
