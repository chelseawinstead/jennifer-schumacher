---
import site from '../data/site.yaml';
const { active = '' } = Astro.props;
---
<nav style="display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 22px 48px; border-bottom: 1px solid #ececec; position: sticky; top: 0; background: rgba(255,255,255,.94); backdrop-filter: blur(8px); z-index: 20;">
  <a href="/" style="display: flex; flex-direction: column; gap: 3px;">
    <span style="font-family: 'Cormorant Garamond', serif; font-size: 22px; letter-spacing: .18em; color: #14181d; font-weight: 500;">{site.name.toUpperCase()}</span>
    <span style="font-size: 9.5px; letter-spacing: .3em; color: #9a968d; text-transform: uppercase;">{site.brokerage}</span>
  </a>
  <input type="checkbox" id="mnav" class="mnav-toggle">
  <label for="mnav" class="burger" aria-label="Menu"><span></span><span></span><span></span></label>
  <div class="navmenu" style="display: flex; gap: 26px; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #3a3f45; white-space: nowrap;">
    {site.nav.map((item) => (
      <a
        href={item.href}
        class="navlink"
        style={item.label === active
          ? 'color: #002349; border-bottom: 1px solid #002349; padding-bottom: 3px;'
          : undefined}
      >{item.label}</a>
    ))}
  </div>
  <div style="display: flex; align-items: center; gap: 20px;">
    <a href={`tel:${site.phone_link}`} style="font-size: 13px; letter-spacing: .1em; color: #14181d; white-space: nowrap;" set:html={site.phone_display}></a>
    <a href={`tel:${site.phone_link}`} style="border: 1px solid #002349; color: #002349; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; padding: 10px 20px;">Contact</a>
  </div>
</nav>
