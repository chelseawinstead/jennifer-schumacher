---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.yaml';
import journal from '../data/journal.yaml';

const { seo, intro, featured_cta, newsletter } = journal;

const F = '/src/data/journal.yaml';
const cc = (path) => `@file[${F}].${path}`;

const posts = (await getCollection('journal', ({ data }) => data.published !== false))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
---
<Base title={seo.title} description={seo.description} image={seo.social_image} active="Journal">

  <!-- INTRO -->
  <section style="padding: 90px 64px 56px; text-align: center;">
    <span data-editable="text" data-prop={cc('intro.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{intro.kicker}</span>
    <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 66px; line-height: 1.05; color: #14181d; margin: 18px auto 20px; max-width: 900px;"><editable-text data-prop={cc('intro.headline_before')} data-type="span">{intro.headline_before}</editable-text><em style="font-style: italic; color: #002349;"><editable-text data-prop={cc('intro.headline_emphasis')} data-type="span">{intro.headline_emphasis}</editable-text></em><editable-text data-prop={cc('intro.headline_after')} data-type="span">{intro.headline_after}</editable-text></h1>
    <p data-editable="text" data-prop={cc('intro.body')} data-type="text" style="font-size: 17px; line-height: 1.7; color: #55585c; font-weight: 300; max-width: 580px; margin: 0 auto;">{intro.body}</p>
  </section>

  {featured && (
    <!-- FEATURED POST -->
    <section style="padding: 0 64px 20px;">
      <a href={`/journal/${featured.data.slug || featured.id}`} class="card" style="display: grid; grid-template-columns: 1.25fr 1fr; align-items: stretch; border: 1px solid #e6e4df;">
        <div style="min-height: 460px; overflow: hidden;">
          <img src={featured.data.image} alt={featured.data.image_alt} style="width:100%;height:100%;object-fit:cover;display:block;">
        </div>
        <div style="padding: 72px 60px; display: flex; flex-direction: column; justify-content: center;">
          <span style="font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: #002349; margin-bottom: 18px;">{featured.data.category} · {featured.data.kicker}</span>
          <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 40px; line-height: 1.12; color: #14181d; margin: 0 0 18px;">{featured.data.title}</h2>
          <p style="font-size: 16px; line-height: 1.75; color: #55585c; font-weight: 300; margin: 0 0 28px;">{featured.data.excerpt}</p>
          <span style="font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #002349; border-bottom: 1px solid #002349; padding-bottom: 4px; align-self: flex-start;">{featured_cta}</span>
        </div>
      </a>
    </section>
  )}

  <!-- POST GRID -->
  <section style="padding: 56px 64px 96px;">
    <div style="display: grid; grid-template-columns: repeat(3,1fr); gap: 40px 28px;">
      {rest.map((post) => (
        <a href={`/journal/${post.data.slug || post.id}`} class="card" style="display: block;">
          <div style="aspect-ratio: 4/3; overflow: hidden;">
            <img src={post.data.image} alt={post.data.image_alt} style="width:100%;height:100%;object-fit:cover;display:block;">
          </div>
          <div style="padding: 22px 2px;">
            <div style="font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #9a968d; margin-bottom: 8px;">{post.data.kicker}</div>
            <div style="font-family: 'Cormorant Garamond', serif; font-size: 25px; color: #14181d; line-height: 1.15;">{post.data.title}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section style="background: #002349; color: #fff; padding: 90px 64px; text-align: center;">
    <span data-editable="text" data-prop={cc('newsletter.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{newsletter.kicker}</span>
    <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 44px; line-height: 1.1; margin: 18px auto 20px; max-width: 640px;"><editable-text data-prop={cc('newsletter.heading')} data-type="span">{newsletter.heading}</editable-text></h2>
    <p style="font-size: 16px; line-height: 1.7; color: #c6d3df; font-weight: 300; max-width: 480px; margin: 0 auto 34px;"><editable-text data-prop={cc('newsletter.body')} data-type="text">{newsletter.body}</editable-text></p>
    <a href={`sms:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 34px;"><editable-text data-prop={cc('newsletter.button')} data-type="span">{newsletter.button}</editable-text></a>
  </section>

</Base>
