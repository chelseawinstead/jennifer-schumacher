---
import Base from '../layouts/Base.astro';
import site from '../data/site.yaml';
import buy from '../data/buy.yaml';

const { seo, hero, process, image_break, advantage, team, cta } = buy;

// CloudCannon visual editing
const F = '/src/data/buy.yaml';
const cc = (path) => `@file[${F}].${path}`;
---
<Base title={seo.title} description={seo.description} image={seo.social_image} active="Buy">

  <!-- HERO -->
  <header class="m-hero" style="display: grid; grid-template-columns: 1.05fr .95fr; align-items: stretch;">
    <div style="padding: 96px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={cc('hero.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 28px;">{hero.kicker}</span>
      <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 68px; line-height: 1.05; letter-spacing: -.01em; color: #14181d; margin: 0 0 26px;"><editable-text data-prop={cc('hero.headline_line1')} data-type="span">{hero.headline_line1}</editable-text><br><editable-text data-prop={cc('hero.headline_line2_prefix')} data-type="span">{hero.headline_line2_prefix}</editable-text>{' '}<em style="font-style: italic; color: #002349;"><editable-text data-prop={cc('hero.headline_emphasis')} data-type="span">{hero.headline_emphasis}</editable-text></em></h1>
      <p data-editable="text" data-prop={cc('hero.body')} data-type="text" style="font-size: 17px; line-height: 1.75; color: #55585c; max-width: 470px; margin: 0 0 38px; font-weight: 300;">{hero.body}</p>
      <a href="#contact" style="align-self: flex-start; background: #002349; color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 17px 34px;"><editable-text data-prop={cc('hero.button')} data-type="span">{hero.button}</editable-text></a>
    </div>
    <div style="min-height: 560px; overflow:hidden;">
      <img data-editable="image" data-prop-src={cc('hero.image')} src={hero.image} alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
    </div>
  </header>

  <!-- PROCESS -->
  <section style="padding: 108px 64px; background: #f6f5f2;">
    <div style="max-width: 1180px; margin: 0 auto 60px;">
      <span data-editable="text" data-prop={cc('process.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{process.kicker}</span>
      <h2 data-editable="text" data-prop={cc('process.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 44px; color: #14181d; margin: 16px 0 0; max-width: 620px;">{process.heading}</h2>
    </div>
    <div data-editable="array" data-prop={cc('process.steps')} class="m-proc" style="display: grid; grid-template-columns: repeat(3,1fr); gap: 60px 56px; max-width: 1180px; margin: 0 auto;">
      {process.steps.map((step) => (
        <div data-editable="array-item">
          <div data-editable="text" data-prop="number" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 30px; color: #002349;">{step.number}</div>
          <div style="height: 1px; background: #e0ded7; margin: 16px 0;"></div>
          <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 23px; color: #14181d; margin: 0 0 10px;">{step.title}</h4>
          <p data-editable="text" data-prop="body" data-type="text" style="font-size: 15px; line-height: 1.75; color: #6b6b66; font-weight: 300; margin: 0;">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- IMAGE BREAK -->
  <section class="m-imgbreak" style="position: relative; height: 460px; overflow: hidden;">
    <img data-editable="image" data-prop-src={cc('image_break.image')} data-prop-alt={cc('image_break.image_alt')} src={image_break.image} alt={image_break.image_alt} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 60%;">
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,20,45,.15) 0%, rgba(0,20,45,.55) 100%);"></div>
    <div style="position: absolute; left: 0; right: 0; bottom: 0; padding: 64px; color: #fff;">
      <p data-editable="text" data-prop={cc('image_break.quote')} data-type="text" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-style: italic; font-size: 34px; line-height: 1.3; margin: 0; max-width: 720px;">{image_break.quote}</p>
    </div>
  </section>

  <!-- THE ADVANTAGE -->
  <section style="padding: 108px 64px; background: #002349; color: #fff;">
    <div style="display: grid; grid-template-columns: .82fr 1.18fr; gap: 72px; align-items: start; max-width: 1200px; margin: 0 auto;">
      <div>
        <span data-editable="text" data-prop={cc('advantage.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{advantage.kicker}</span>
        <h2 data-editable="text" data-prop={cc('advantage.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 44px; line-height: 1.12; margin: 18px 0 20px;">{advantage.heading}</h2>
        <p data-editable="text" data-prop={cc('advantage.body')} data-type="text" style="font-size: 16px; line-height: 1.8; color: #c6d3df; font-weight: 300; margin: 0;">{advantage.body}</p>
      </div>
      <div data-editable="array" data-prop={cc('advantage.items')} style="display: grid; grid-template-columns: 1fr 1fr; gap: 34px 48px;">
        {advantage.items.map((item) => (
          <div data-editable="array-item" style="border-top: 1px solid rgba(255,255,255,.18); padding-top: 20px;">
            <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 22px; margin: 0 0 8px;">{item.title}</h4>
            <p data-editable="text" data-prop="body" data-type="text" style="font-size: 14.5px; line-height: 1.7; color: #a9bccf; font-weight: 300; margin: 0;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUYER'S TEAM -->
  <section style="display: grid; grid-template-columns: 0.82fr 1.18fr; align-items: stretch;">
    <div style="min-height: 440px; overflow: hidden;">
      <img data-editable="image" data-prop-src={cc('team.image')} data-prop-alt={cc('team.image_alt')} src={team.image} alt={team.image_alt} style="width:100%;height:100%;object-fit:cover;object-position:center top;display:block;">
    </div>
    <div style="padding: 104px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={cc('team.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 22px;">{team.kicker}</span>
      <h2 data-editable="text" data-prop={cc('team.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 44px; line-height: 1.12; color: #14181d; margin: 0 0 24px;">{team.heading}</h2>
      <p style="font-size: 16px; line-height: 1.85; color: #55585c; font-weight: 300; margin: 0 0 20px;"><editable-text data-prop={cc('team.paragraph1_before')} data-type="span">{team.paragraph1_before}</editable-text>{' '}{team.paragraph1_name_url
        ? <a href={team.paragraph1_name_url} target="_blank" rel="noopener" style="font-weight: 500; color: #14181d;"><editable-text data-prop={cc('team.paragraph1_name')} data-type="span">{team.paragraph1_name}</editable-text></a>
        : <strong style="font-weight: 500; color: #14181d;"><editable-text data-prop={cc('team.paragraph1_name')} data-type="span">{team.paragraph1_name}</editable-text></strong>}<editable-text data-prop={cc('team.paragraph1_after')} data-type="text">{team.paragraph1_after}</editable-text></p>
      <p data-editable="text" data-prop={cc('team.paragraph2')} data-type="text" style="font-size: 16px; line-height: 1.85; color: #55585c; font-weight: 300; margin: 0;">{team.paragraph2}</p>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" style="background: #002349; color: #fff; padding: 96px 64px; text-align: center;">
    <span data-editable="text" data-prop={cc('cta.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{cta.kicker}</span>
    <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 54px; line-height: 1.1; margin: 20px auto 22px; max-width: 760px;"><editable-text data-prop={cc('cta.heading')} data-type="span">{cta.heading}</editable-text></h2>
    <p style="font-size: 17px; line-height: 1.7; color: #c6d3df; font-weight: 300; max-width: 520px; margin: 0 auto 38px;"><editable-text data-prop={cc('cta.body')} data-type="text">{cta.body}</editable-text></p>
    <div style="display: flex; gap: 16px; justify-content: center;">
      <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 17px 34px;"><editable-text data-prop={cc('cta.button_call')} data-type="span">{cta.button_call}</editable-text>{' '}<span set:html={site.phone_display}></span></a>
      <a href={`sms:${site.phone_link}`} style="border: 1px solid rgba(255,255,255,.5); color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 17px 34px;"><editable-text data-prop={cc('cta.button_text')} data-type="span">{cta.button_text}</editable-text></a>
    </div>
  </section>

</Base>
