---
import Base from '../layouts/Base.astro';
import site from '../data/site.yaml';
import home from '../data/home.yaml';

const { seo, hero, split, why, stats, communities, listings, testimonials, affiliations, cta } = home;

// CloudCannon visual editing: point an element at a value in home.yaml
const F = '/src/data/home.yaml';
const p = (path) => `@file[${F}].${path}`;

// Stand-in artwork shown until a real photo is uploaded. Rendering a genuine
// <img> (rather than an empty box) is what gives CloudCannon something to
// click, so photos can be swapped directly on the page.
const PH = '/assets/placeholder-community.svg';
---
<Base title={seo.title} description={seo.description} image={seo.social_image} active="Home">

  <!-- HERO -->
  <header class="m-hero" style="display: grid; grid-template-columns: 1.05fr .95fr; align-items: stretch;">
    <div style="padding: 92px 64px 88px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={p('hero.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 30px;">{hero.kicker}</span>
      <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 74px; line-height: 1.04; letter-spacing: -.01em; color: #14181d; margin: 0 0 30px;"><editable-text data-prop={p('hero.headline_line1')} data-type="span">{hero.headline_line1}</editable-text><br><em style="font-style: italic; color: #002349;"><editable-text data-prop={p('hero.headline_emphasis')} data-type="span">{hero.headline_emphasis}</editable-text></em></h1>
      <p data-editable="text" data-prop={p('hero.body')} data-type="text" style="font-size: 17px; line-height: 1.75; color: #55585c; max-width: 460px; margin: 0 0 40px; font-weight: 300;">{hero.body}</p>
      <div style="display: flex; gap: 16px;">
        <a href={`tel:${site.phone_link}`} style="background: #002349; color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={p('hero.button_call')} data-type="span">{hero.button_call}</editable-text></a>
        <a href={`sms:${site.phone_link}`} style="border: 1px solid #cdccc6; color: #14181d; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={p('hero.button_text')} data-type="span">{hero.button_text}</editable-text></a>
      </div>
    </div>
    <div style="min-height: 620px;">
      <img data-editable="image" data-prop-src={p('hero.image')} data-prop-alt={p('hero.image_alt')} src={hero.image} alt={hero.image_alt} style="width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block;">
    </div>
  </header>

  <!-- BUYER / SELLER -->
  <section data-editable="array" data-prop={p('split')} class="m-split" style="display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #ececec;">
    {split.map((card, i) => (
      <a data-editable="array-item" href={card.href} style={i === 0
        ? 'display: block; padding: 66px 64px; border-right: 1px solid #ececec;'
        : 'display: block; padding: 66px 64px; background: #f6f5f2;'}>
        <span data-editable="text" data-prop="kicker" data-type="span" style="font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: #9a968d;">{card.kicker}</span>
        <h3 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 40px; color: #14181d; margin: 14px 0 14px;">{card.title}</h3>
        <p data-editable="text" data-prop="body" data-type="text" style="font-size: 15px; line-height: 1.7; color: #6b6b66; font-weight: 300; margin: 0 0 26px; max-width: 400px;">{card.body}</p>
        <span style="font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #002349; border-bottom: 1px solid #002349; padding-bottom: 4px;"><editable-text data-prop="cta" data-type="span">{card.cta}</editable-text></span>
      </a>
    ))}
  </section>

  <!-- WHY -->
  <section style="padding: 96px 64px; border-top: 1px solid #ececec;">
    <div style="text-align: center; margin-bottom: 66px;">
      <span data-editable="text" data-prop={p('why.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{why.kicker}</span>
      <h2 data-editable="text" data-prop={p('why.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 48px; color: #14181d; margin: 16px 0 0;">{why.heading}</h2>
    </div>
    <div data-editable="array" data-prop={p('why.items')} class="m-why" style="display: grid; grid-template-columns: repeat(3,1fr); gap: 56px;">
      {why.items.map((item, i) => (
        <div data-editable="array-item">
          <div data-editable="text" data-prop="number" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 30px; color: #002349;">{item.number}</div>
          <div style="height: 1px; background: #e0ded7; margin: 18px 0;"></div>
          <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 24px; color: #14181d; margin: 0 0 12px;">{item.title}</h4>
          <p data-editable="text" data-prop="body" data-type="text" style="font-size: 15px; line-height: 1.7; color: #6b6b66; font-weight: 300; margin: 0;">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- STATS -->
  <section data-editable="array" data-prop={p('stats')} style="background: #002349; color: #fff; padding: 78px 64px; display: grid; grid-template-columns: repeat(4,1fr); gap: 40px;">
    {stats.map((stat, i) => (
      <div data-editable="array-item" style={i === 0
        ? 'text-align: center;'
        : 'text-align: center; border-left: 1px solid rgba(255,255,255,.14);'}>
        <div data-editable="text" data-prop="value" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 58px; line-height: 1;">{stat.value}</div>
        <div data-editable="text" data-prop="label" data-type="span" style="font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: #9db4cb; margin-top: 14px;">{stat.label}</div>
      </div>
    ))}
  </section>

  <!-- FEATURED COMMUNITIES -->
  <section style="padding: 96px 64px 80px;">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 44px;">
      <div>
        <span data-editable="text" data-prop={p('communities.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{communities.kicker}</span>
        <h2 data-editable="text" data-prop={p('communities.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 46px; color: #14181d; margin: 14px 0 0;">{communities.heading}</h2>
      </div>
      <a href={communities.link_href} style="font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #6b6b66;"><editable-text data-prop={p('communities.link_label')} data-type="span">{communities.link_label}</editable-text></a>
    </div>
    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: 262px; gap: 20px;">

      {/* Not linked for now — city pages still to be designed. Wrap this div in an anchor to re-enable. */}
      <div style="grid-row: span 2; position: relative; overflow: hidden; display: block;">
        <div class="ph" style="position: absolute; inset: 0;">
          <img data-editable="image" data-prop-src={p('communities.featured.image')} src={communities.featured.image || PH} alt={communities.featured.name} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;">
          {!communities.featured.image && <span class="phl">{communities.featured.placeholder}</span>}
        </div>
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,20,45,0) 38%, rgba(0,20,45,.74) 100%);"></div>
        <div style="position: absolute; left: 0; right: 0; bottom: 0; padding: 34px;">
          <div style="display: inline-block; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #fff; border: 1px solid rgba(255,255,255,.6); padding: 5px 11px; margin-bottom: 16px;"><editable-text data-prop={p('communities.featured.badge')} data-type="span">{communities.featured.badge}</editable-text></div>
          <div data-editable="text" data-prop={p('communities.featured.name')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 36px; color: #fff; line-height: 1;">{communities.featured.name}</div>
          <div data-editable="text" data-prop={p('communities.featured.blurb')} data-type="text" style="font-size: 13px; color: rgba(255,255,255,.85); margin-top: 10px; max-width: 340px; font-weight: 300; line-height: 1.6;">{communities.featured.blurb}</div>
          <div style="font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: #fff; border-bottom: 1px solid #fff; padding-bottom: 3px; display: inline-block; margin-top: 18px;"><editable-text data-prop={p('communities.featured.cta')} data-type="span">{communities.featured.cta}</editable-text></div>
        </div>
      </div>

      <div data-editable="array" data-prop={p('communities.others')} style="display: contents;">
      {communities.others.map((c, i) => (
        <div data-editable="array-item" style={c.span
          ? 'grid-column: span 2; position: relative; overflow: hidden; display: block;'
          : 'position: relative; overflow: hidden; display: block;'}>
          <div class="ph" style="position: absolute; inset: 0;">
            <img data-editable="image" data-prop-src="image" src={c.image || PH} alt={c.name} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;">
            {!c.image && <span class="phl">{c.placeholder}</span>}
          </div>
          <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,20,45,0) 45%, rgba(0,20,45,.64) 100%);"></div>
          <div style="position: absolute; left: 0; right: 0; bottom: 0; padding: 22px;">
            <div data-editable="text" data-prop="name" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 23px; color: #fff; line-height: 1;">{c.name}</div>
            <div data-editable="text" data-prop="sub" data-type="span" style="font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.8); margin-top: 6px;">{c.sub}</div>
          </div>
        </div>
      ))}
      </div>
    </div>
  </section>

  <!-- FEATURED LISTINGS -->
  <section style="padding: 40px 64px 96px; background: #f6f5f2;">
    <div style="padding-top: 56px; display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 44px;">
      <div>
        <span data-editable="text" data-prop={p('listings.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{listings.kicker}</span>
        <h2 data-editable="text" data-prop={p('listings.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 46px; color: #14181d; margin: 14px 0 0;">{listings.heading}</h2>
      </div>
      <a href={listings.link_href} style="font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #6b6b66;"><editable-text data-prop={p('listings.link_label')} data-type="span">{listings.link_label}</editable-text></a>
    </div>
    <div data-editable="array" data-prop={p('listings.items')} style="display: grid; grid-template-columns: repeat(3,1fr); gap: 28px;">
      {listings.items.map((l, i) => (
        <a data-editable="array-item" href={l.href} style="display: block; background: #fff;">
          <div style="aspect-ratio: 4/3; overflow:hidden;">
            <img data-editable="image" data-prop-src="image" src={l.image} alt={`${l.address}, ${l.city}`} style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
          </div>
          <div style="padding: 22px 24px 26px;">
            <div data-editable="text" data-prop="price" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 26px; color: #14181d;">{l.price}</div>
            <div style="font-size: 14px; color: #6b6b66; margin: 6px 0 14px;"><editable-text data-prop="address" data-type="span">{l.address}</editable-text> · <editable-text data-prop="city" data-type="span">{l.city}</editable-text></div>
            <div data-editable="text" data-prop="specs" data-type="span" style="font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #9a968d;">{l.specs}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section style="padding: 96px 64px;">
    <div style="text-align: center; margin-bottom: 60px;">
      <span data-editable="text" data-prop={p('testimonials.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{testimonials.kicker}</span>
      <h2 data-editable="text" data-prop={p('testimonials.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 48px; color: #14181d; margin: 16px 0 14px;">{testimonials.heading}</h2>
      <div style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: .04em; color: #6b6b66;"><span style="color: #002349; letter-spacing: .12em;">★★★★★</span> <editable-text data-prop={p('testimonials.rating_line')} data-type="span">{testimonials.rating_line}</editable-text></div>
    </div>
    <div data-editable="array" data-prop={p('testimonials.items')} style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 1080px; margin: 0 auto;">
      {testimonials.items.map((t, i) => (
        <blockquote data-editable="array-item" style="margin: 0; border-top: 2px solid #002349; padding-top: 24px;">
          <p data-editable="text" data-prop="quote" data-type="text" style="font-family: 'Cormorant Garamond', serif; font-size: 25px; line-height: 1.5; color: #24272b; font-style: italic; margin: 0 0 20px;">{t.quote}</p>
          <footer style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #9a968d;"><editable-text data-prop="author" data-type="span">{t.author}</editable-text> · ★★★★★</footer>
        </blockquote>
      ))}
    </div>
    <div style="text-align: center; margin-top: 52px;">
      <a href={testimonials.reviews_url} target="_blank" rel="noopener" style="display: inline-block; border: 1px solid #002349; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 15px 32px;"><editable-text data-prop={p('testimonials.reviews_cta')} data-type="span">{testimonials.reviews_cta}</editable-text></a>
    </div>
  </section>

  <!-- AS SEEN IN -->
  <section style="padding: 56px 64px; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; background: #fbfaf8;">
    <div data-editable="text" data-prop={p('affiliations.label')} data-type="span" style="text-align: center; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: #9a968d; margin-bottom: 30px;">{affiliations.label}</div>
    <div style="display: flex; align-items: center; justify-content: center; gap: 64px; flex-wrap: wrap; opacity: .7;">
      {affiliations.serif.map((a) => (
        <span style="font-family: 'Cormorant Garamond', serif; font-size: 20px; letter-spacing: .16em; color: #14181d;">{a}</span>
      ))}
      {affiliations.plain.map((a) => (
        <span style="font-size: 13px; letter-spacing: .22em; text-transform: uppercase; color: #14181d;">{a}</span>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="contact" style="display: grid; grid-template-columns: 1fr 1fr;">
    <div style="min-height: 460px; overflow:hidden;">
      <img data-editable="image" data-prop-src={p('cta.image')} src={cta.image} alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
    </div>
    <div style="background: #002349; color: #fff; padding: 92px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={p('cta.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb; margin-bottom: 24px;">{cta.kicker}</span>
      <h2 data-editable="text" data-prop={p('cta.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 52px; line-height: 1.08; margin: 0 0 24px;">{cta.heading}</h2>
      <p data-editable="text" data-prop={p('cta.body')} data-type="text" style="font-size: 16px; line-height: 1.7; color: #c6d3df; font-weight: 300; max-width: 420px; margin: 0 0 36px;">{cta.body}</p>
      <div style="display: flex; gap: 16px; align-items: center;">
        <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={p('cta.button_call')} data-type="span">{cta.button_call}</editable-text>{' '}<span set:html={site.phone_display}></span></a>
        <a href={`sms:${site.phone_link}`} style="border: 1px solid rgba(255,255,255,.4); color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={p('cta.button_text')} data-type="span">{cta.button_text}</editable-text></a>
      </div>
    </div>
  </section>

</Base>
