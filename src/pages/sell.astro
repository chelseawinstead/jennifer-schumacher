---
import Base from '../layouts/Base.astro';
import site from '../data/site.yaml';
import sell from '../data/sell.yaml';

const { seo, hero, positioning, included, why, showcase, process, review, cta } = sell;

// CloudCannon visual editing
const F = '/src/data/sell.yaml';
const cc = (path) => `@file[${F}].${path}`;
---
<Base title={seo.title} description={seo.description} image={seo.social_image} active="Sell">

  <!-- HERO -->
  <header style="position: relative; color: #fff;">
    <img data-editable="image" data-prop-src={cc('hero.image')} src={hero.image} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;">
    <div style="position: absolute; inset: 0; background: linear-gradient(120deg, rgba(0,20,45,.86) 0%, rgba(0,20,45,.55) 100%);"></div>
    <div style="position: relative; padding: 150px 64px; max-width: 780px;">
      <span data-editable="text" data-prop={cc('hero.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb; margin-bottom: 26px; display: block;">{hero.kicker}</span>
      <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 84px; line-height: 1.02; letter-spacing: -.015em; margin: 0 0 28px;"><editable-text data-prop={cc('hero.headline_before')} data-type="span">{hero.headline_before}</editable-text><em style="font-style: italic;"><editable-text data-prop={cc('hero.headline_emphasis')} data-type="span">{hero.headline_emphasis}</editable-text></em></h1>
      <p data-editable="text" data-prop={cc('hero.body')} data-type="text" style="font-size: 19px; line-height: 1.75; color: #d3dde7; max-width: 560px; margin: 0 0 40px; font-weight: 300;">{hero.body}</p>
      <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 18px 36px;"><editable-text data-prop={cc('hero.button')} data-type="span">{hero.button}</editable-text></a>
    </div>
  </header>

  <!-- POSITIONING -->
  <section style="padding: 120px 64px; background: #f6f5f2;">
    <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
      <span data-editable="text" data-prop={cc('positioning.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{positioning.kicker}</span>
      <p data-editable="text" data-prop={cc('positioning.statement')} data-type="text" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 38px; line-height: 1.4; color: #24272b; margin: 28px 0 0;">{positioning.statement}</p>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section style="padding: 112px 64px;">
    <div style="max-width: 1200px; margin: 0 auto 64px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; border-bottom: 1px solid #ececec; padding-bottom: 34px;">
      <div>
        <span data-editable="text" data-prop={cc('included.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{included.kicker}</span>
        <h2 data-editable="text" data-prop={cc('included.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 48px; color: #14181d; margin: 14px 0 0;">{included.heading}</h2>
      </div>
      <p data-editable="text" data-prop={cc('included.intro')} data-type="text" style="font-size: 15px; line-height: 1.7; color: #6b6b66; font-weight: 300; max-width: 380px; margin: 0;">{included.intro}</p>
    </div>
    <div data-editable="array" data-prop={cc('included.pillars')} style="display: grid; grid-template-columns: repeat(3,1fr); gap: 60px 56px; max-width: 1200px; margin: 0 auto;">
      {included.pillars.map((pillar) => (
        <div data-editable="array-item">
          <div data-editable="text" data-prop="number" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 30px; color: #002349;">{pillar.number}</div>
          <div style="height: 1px; background: #e0ded7; margin: 16px 0;"></div>
          <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 24px; color: #14181d; margin: 0 0 10px;">{pillar.title}</h4>
          <p data-editable="text" data-prop="body" data-type="text" style="font-size: 15px; line-height: 1.75; color: #6b6b66; font-weight: 300; margin: 0;">{pillar.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY JENNIFER -->
  <section style="background: #002349; color: #fff; padding: 112px 64px;">
    <div style="display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: center; max-width: 1200px; margin: 0 auto 72px;">
      <div style="min-height: 470px; overflow: hidden;">
        <img data-editable="image" data-prop-src={cc('why.image')} data-prop-alt={cc('why.image_alt')} src={why.image} alt={why.image_alt} style="width:100%;height:100%;object-fit:cover;object-position:center 15%;display:block;">
      </div>
      <div>
        <span data-editable="text" data-prop={cc('why.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{why.kicker}</span>
        <h2 data-editable="text" data-prop={cc('why.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 46px; line-height: 1.12; margin: 16px 0 18px;">{why.heading}</h2>
        <p data-editable="text" data-prop={cc('why.body')} data-type="text" style="font-size: 16px; line-height: 1.8; color: #c6d3df; font-weight: 300; margin: 0;">{why.body}</p>
      </div>
    </div>
    <div data-editable="array" data-prop={cc('why.cards')} style="display: grid; grid-template-columns: repeat(2,1fr); gap: 28px; max-width: 1000px; margin: 0 auto;">
      {why.cards.map((card) => (
        <div data-editable="array-item" style="background: #0c3564; padding: 32px 34px; border-radius: 5px;">
          <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 23px; margin: 0 0 8px;">{card.title}</h4>
          <p data-editable="text" data-prop="body" data-type="text" style="font-size: 14.5px; line-height: 1.7; color: #c3d3e3; font-weight: 300; margin: 0;">{card.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- MARKETING SHOWCASE -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; background: #f6f5f2;">
    <div style="min-height: 520px; overflow:hidden;">
      <img data-editable="image" data-prop-src={cc('showcase.image')} src={showcase.image} alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
    </div>
    <div style="padding: 96px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={cc('showcase.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 22px;">{showcase.kicker}</span>
      <h2 data-editable="text" data-prop={cc('showcase.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 42px; line-height: 1.12; color: #14181d; margin: 0 0 22px;">{showcase.heading}</h2>
      <p data-editable="text" data-prop={cc('showcase.body')} data-type="text" style="font-size: 16px; line-height: 1.8; color: #55585c; font-weight: 300; margin: 0 0 20px;">{showcase.body}</p>
      <div data-editable="text" data-prop={cc('showcase.attribution')} data-type="span" style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #9a968d;">{showcase.attribution}</div>
    </div>
  </section>

  <!-- WHAT HAPPENS WHEN YOU LIST -->
  <section style="padding: 112px 64px; background: #14181d; color: #fff;">
    <div style="max-width: 1080px; margin: 0 auto;">
      <div style="margin-bottom: 20px;">
        <span data-editable="text" data-prop={cc('process.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{process.kicker}</span>
        <h2 data-editable="text" data-prop={cc('process.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 46px; line-height: 1.12; margin: 14px 0 0; max-width: 640px;">{process.heading}</h2>
      </div>
      <div data-editable="array" data-prop={cc('process.steps')}>
        {process.steps.map((step, i) => (
          <div data-editable="array-item" style={i === process.steps.length - 1
            ? 'display: grid; grid-template-columns: 88px 1fr; gap: 32px; align-items: baseline; padding: 40px 0; border-top: 1px solid rgba(255,255,255,.16); border-bottom: 1px solid rgba(255,255,255,.16);'
            : 'display: grid; grid-template-columns: 88px 1fr; gap: 32px; align-items: baseline; padding: 40px 0; border-top: 1px solid rgba(255,255,255,.16);'}>
            <div data-editable="text" data-prop="number" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-size: 56px; line-height: .9; color: #6d86a0;">{step.number}</div>
            <div style="display: grid; grid-template-columns: .8fr 1.2fr; gap: 40px; align-items: baseline;">
              <h4 data-editable="text" data-prop="title" data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 27px; margin: 0;">{step.title}</h4>
              <p data-editable="text" data-prop="body" data-type="text" style="font-size: 15.5px; line-height: 1.8; color: #c3d3e3; font-weight: 300; margin: 0;">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p data-editable="text" data-prop={cc('process.footnote')} data-type="text" style="font-size: 15px; line-height: 1.7; color: #8ca0b3; font-weight: 300; font-style: italic; margin: 40px 0 0;">{process.footnote}</p>
    </div>
  </section>

  <!-- FEATURED REVIEW -->
  <section style="padding: 118px 64px; background: #f6f5f2; text-align: center;">
    <div style="max-width: 940px; margin: 0 auto;">
      <div style="font-size: 22px; letter-spacing: .3em; color: #002349; margin-bottom: 30px;">{review.stars}</div>
      <p data-editable="text" data-prop={cc('review.quote')} data-type="text" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 40px; line-height: 1.4; font-style: italic; color: #24272b; margin: 0 0 32px;">{review.quote}</p>
      <div data-editable="text" data-prop={cc('review.attribution')} data-type="span" style="font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: #9a968d;">{review.attribution}</div>
    </div>
  </section>

  <!-- HOME VALUE CTA -->
  <section id="contact" style="display: grid; grid-template-columns: 1fr 1fr;">
    <div style="background: #002349; color: #fff; padding: 96px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={cc('cta.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb; margin-bottom: 24px;">{cta.kicker}</span>
      <h2 data-editable="text" data-prop={cc('cta.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 52px; line-height: 1.08; margin: 0 0 24px;">{cta.heading}</h2>
      <p data-editable="text" data-prop={cc('cta.body')} data-type="text" style="font-size: 16px; line-height: 1.7; color: #c6d3df; font-weight: 300; max-width: 420px; margin: 0 0 36px;">{cta.body}</p>
      <div style="display: flex; gap: 16px;">
        <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={cc('cta.button_primary')} data-type="span">{cta.button_primary}</editable-text></a>
        <a href={`tel:${site.phone_link}`} style="border: 1px solid rgba(255,255,255,.4); color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={cc('cta.button_secondary')} data-type="span">{cta.button_secondary}</editable-text></a>
      </div>
    </div>
    <div style="min-height: 480px; overflow:hidden;">
      <img data-editable="image" data-prop-src={cc('cta.image')} src={cta.image} alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
    </div>
  </section>

</Base>
