---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.yaml';
import listings from '../data/listings.yaml';

const { seo, intro, featured_cta, video, property_pages, cta } = listings;

const F = '/src/data/listings.yaml';
const cc = (path) => `@file[${F}].${path}`;

const homes = (await getCollection('listings', ({ data }) => data.published !== false))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const featured = homes.find((h) => h.data.featured) ?? homes[0];
const rest = homes.filter((h) => h.id !== featured?.id);

const specs = (d) => [d.beds && `${d.beds} Bed`, d.baths && `${d.baths} Bath`, d.sqft]
  .filter(Boolean).join(' · ');
---
<Base title={seo.title} description={seo.description} image={seo.social_image} active="Listings">

  <!-- INTRO -->
  <section style="padding: 90px 64px 60px; text-align: center;">
    <span data-editable="text" data-prop={cc('intro.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{intro.kicker}</span>
    <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 66px; line-height: 1.05; color: #14181d; margin: 18px auto 20px; max-width: 900px;">{intro.headline_before}<em style="font-style: italic; color: #002349;"><editable-text data-prop={cc('intro.headline_emphasis')} data-type="span">{intro.headline_emphasis}</editable-text></em></h1>
    <p data-editable="text" data-prop={cc('intro.body')} data-type="text" style="font-size: 17px; line-height: 1.7; color: #55585c; font-weight: 300; max-width: 560px; margin: 0 auto;">{intro.body}</p>
  </section>

  {featured && (
    <!-- FEATURED HERO LISTING -->
    <section style="padding: 0 64px 20px;">
      <a href={`/listings/${featured.data.slug || featured.id}`} style="display: block;">
        <div style="aspect-ratio: 21/9; overflow:hidden;">
          <img src={featured.data.image} alt={featured.data.address} style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
        </div>
      </a>
      <div style="display: flex; align-items: flex-end; justify-content: space-between; padding: 26px 4px 0; flex-wrap: wrap; gap: 20px;">
        <div>
          <div style="font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: #9a968d; margin-bottom: 8px;">{featured.data.status} · {featured.data.city.replace(/,.*$/, '')}</div>
          <div style="font-family: 'Cormorant Garamond', serif; font-size: 40px; color: #14181d; line-height: 1;">{featured.data.price}</div>
          <div style="font-size: 15px; color: #6b6b66; margin-top: 8px;">{featured.data.address}, {featured.data.city} &nbsp;·&nbsp; {specs(featured.data)}</div>
        </div>
        <a href={`/listings/${featured.data.slug || featured.id}`} style="font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #002349; border-bottom: 1px solid #002349; padding-bottom: 4px;">{featured_cta}</a>
      </div>
    </section>
  )}

  <!-- GRID -->
  <section style="padding: 70px 64px 90px;">
    <div style="display: grid; grid-template-columns: repeat(2,1fr); gap: 40px;">
      {rest.map((home) => (
        <a href={`/listings/${home.data.slug || home.id}`} style="display: block;">
          <div style="aspect-ratio: 3/2; overflow:hidden;">
            <img src={home.data.image} alt={home.data.address} style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
          </div>
          <div style="padding: 22px 4px;">
            <div style="font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #9a968d; margin-bottom: 6px;">{home.data.city.replace(/,.*$/, '')}</div>
            <div style="font-family: 'Cormorant Garamond', serif; font-size: 30px; color: #14181d;">{home.data.price}</div>
            <div style={`font-size: 14px; margin: 6px 0 0; color: ${home.data.address === 'Address line' ? '#8f2c2c' : '#6b6b66'};`}>{home.data.address} · {specs(home.data)}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- VIDEO -->
  <section style="position: relative; color: #fff;">
    <img data-editable="image" data-prop-src={cc('video.image')} src={video.image} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
    <div style="position: absolute; inset: 0; background: rgba(0,20,45,.66);"></div>
    <div style="position: relative; padding: 120px 64px; text-align: center;">
      <div style="width: 84px; height: 84px; border: 1px solid rgba(255,255,255,.6); border-radius: 999px; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px;"><span style="border-left: 18px solid #fff; border-top: 11px solid transparent; border-bottom: 11px solid transparent; margin-left: 6px;"></span></div>
      <span data-editable="text" data-prop={cc('video.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{video.kicker}</span>
      <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 48px; line-height: 1.1; margin: 18px auto 18px; max-width: 700px;"><editable-text data-prop={cc('video.heading')} data-type="span">{video.heading}</editable-text></h2>
      <p style="font-size: 16px; line-height: 1.7; color: #d3dde7; font-weight: 300; max-width: 520px; margin: 0 auto;"><editable-text data-prop={cc('video.body')} data-type="text">{video.body}</editable-text></p>
    </div>
  </section>

  <!-- PROPERTY PAGES NOTE -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; align-items: stretch;">
    <div style="padding: 96px 64px; display: flex; flex-direction: column; justify-content: center;">
      <span data-editable="text" data-prop={cc('property_pages.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 22px;">{property_pages.kicker}</span>
      <h2 data-editable="text" data-prop={cc('property_pages.heading')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 42px; line-height: 1.12; color: #14181d; margin: 0 0 22px;">{property_pages.heading}</h2>
      <p data-editable="text" data-prop={cc('property_pages.body')} data-type="text" style="font-size: 16px; line-height: 1.8; color: #55585c; font-weight: 300; margin: 0 0 30px;">{property_pages.body}</p>
      <a href={`tel:${site.phone_link}`} style="align-self: flex-start; background: #002349; color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 30px;"><editable-text data-prop={cc('property_pages.button')} data-type="span">{property_pages.button}</editable-text></a>
    </div>
    <div style="min-height: 480px; overflow:hidden;">
      <img data-editable="image" data-prop-src={cc('property_pages.image')} src={property_pages.image} alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" style="background: #002349; color: #fff; padding: 96px 64px; text-align: center;">
    <span data-editable="text" data-prop={cc('cta.kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">{cta.kicker}</span>
    <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 52px; line-height: 1.1; margin: 20px auto 22px; max-width: 720px;"><editable-text data-prop={cc('cta.heading')} data-type="span">{cta.heading}</editable-text></h2>
    <p style="font-size: 17px; line-height: 1.7; color: #c6d3df; font-weight: 300; max-width: 520px; margin: 0 auto 38px;"><editable-text data-prop={cc('cta.body')} data-type="text">{cta.body}</editable-text></p>
    <div style="display: flex; gap: 16px; justify-content: center;">
      <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 17px 34px;"><editable-text data-prop="@file[/src/data/site.yaml].buttons.call_prefix" data-type="span">{site.buttons?.call_prefix ?? 'Call '}</editable-text><span set:html={site.phone_display}></span></a>
      <a href={`sms:${site.phone_link}`} style="border: 1px solid rgba(255,255,255,.5); color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 17px 34px;"><editable-text data-prop="@file[/src/data/site.yaml].buttons.text" data-type="span">{site.buttons?.text ?? 'Text Jennifer'}</editable-text></a>
    </div>
  </section>

</Base>
