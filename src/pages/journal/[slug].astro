---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.yaml';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => data.published !== false);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

// CloudCannon visual editing — this post's own markdown file
const F = `/src/content/journal/${post.id}.md`;
const cc = (path) => `@file[${F}].${path}`;

const others = (await getCollection('journal', ({ data }) => data.published !== false))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title={`${d.title} — The Journal | Jennifer Schumacher`} description={d.excerpt} image={d.image} active="Journal">

  <article>
    <!-- ARTICLE HEADER -->
    <header style="padding: 64px 64px 48px; max-width: 860px; margin: 0 auto; text-align: center;">
      <div style="font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: #9a968d; margin-bottom: 26px;">
        <a href="/journal" class="navlink">← The Journal</a> &nbsp;·&nbsp; {d.category}
      </div>
      <span data-editable="text" data-prop={cc('kicker')} data-type="span" style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349;">{d.kicker}</span>
      <h1 data-editable="text" data-prop={cc('title')} data-type="span" style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 60px; line-height: 1.06; color: #14181d; margin: 20px 0 24px;">{d.title}</h1>
      <p data-editable="text" data-prop={cc('excerpt')} data-type="text" style="font-size: 18px; line-height: 1.7; color: #55585c; font-weight: 300; margin: 0 auto; max-width: 640px;">{d.excerpt}</p>
      <div style="font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #9a968d; margin-top: 30px;">
        By <editable-text data-prop={cc('author')} data-type="span">{d.author}</editable-text> &nbsp;·&nbsp; <editable-text data-prop={cc('read_time')} data-type="span">{d.read_time}</editable-text>
      </div>
    </header>

    <!-- HERO IMAGE -->
    {d.image && (
      <div style="padding: 0 64px;">
        <div style="height: 560px; overflow: hidden;">
          <img data-editable="image" data-prop-src={cc('image')} data-prop-alt={cc('image_alt')} src={d.image} alt={d.image_alt} style="width: 100%; height: 100%; object-fit: cover; display: block;">
        </div>
        {d.image_caption && (
          <div data-editable="text" data-prop={cc('image_caption')} data-type="span" style="font-size: 12px; color: #9a968d; font-weight: 300; padding: 12px 2px 0;">{d.image_caption}</div>
        )}
      </div>
    )}

    <!-- BODY -->
    <div style="max-width: 720px; margin: 0 auto; padding: 64px 64px 64px;">
      {d.lede && (
        <p data-editable="text" data-prop={cc('lede')} data-type="text" style="font-family: 'Cormorant Garamond', serif; font-size: 26px; line-height: 1.5; color: #24272b; font-style: italic; margin: 0 0 40px;">{d.lede}</p>
      )}
      <div class="prose" data-editable="text" data-prop={cc('@content')} data-type="block">
        <Content />
      </div>
    </div>
  </article>

  <!-- AUTHOR / CTA -->
  <section style="background: #002349; color: #fff; padding: 80px 64px; text-align: center;">
    <span style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #9db4cb;">Thinking about the Valley?</span>
    <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 42px; line-height: 1.12; margin: 18px auto 20px; max-width: 640px;">Let's talk about where you'd fit.</h2>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href={`tel:${site.phone_link}`} style="background: #fff; color: #002349; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 32px;"><editable-text data-prop="@file[/src/data/site.yaml].buttons.call_prefix" data-type="span">{site.buttons?.call_prefix ?? 'Call '}</editable-text><span set:html={site.phone_display}></span></a>
      <a href={`sms:${site.phone_link}`} style="border: 1px solid rgba(255,255,255,.4); color: #fff; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding: 16px 32px;"><editable-text data-prop="@file[/src/data/site.yaml].buttons.text" data-type="span">{site.buttons?.text ?? 'Text Jennifer'}</editable-text></a>
    </div>
  </section>

  <!-- MORE POSTS -->
  {others.length > 0 && (
    <section style="padding: 88px 64px 96px;">
      <div style="font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #002349; margin-bottom: 30px;">More from the Journal</div>
      <div style="display: grid; grid-template-columns: repeat(3,1fr); gap: 40px 28px;">
        {others.map((o) => (
          <a href={`/journal/${o.id}`} class="card" style="display: block;">
            <div style="aspect-ratio: 4/3; overflow: hidden;">
              <img src={o.data.image} alt={o.data.image_alt} style="width:100%;height:100%;object-fit:cover;display:block;">
            </div>
            <div style="padding: 22px 2px;">
              <div style="font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #9a968d; margin-bottom: 8px;">{o.data.kicker}</div>
              <div style="font-family: 'Cormorant Garamond', serif; font-size: 25px; color: #14181d; line-height: 1.15;">{o.data.title}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

</Base>

<style is:global>
  /* Rendered markdown body — matches the original article styling */
  .prose h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500; font-size: 30px; color: #14181d;
    margin: 44px 0 8px; padding-bottom: 0;
  }
  .prose h2::after {
    content: ''; display: block; height: 2px; width: 48px;
    background: #002349; margin-top: 16px; margin-bottom: 8px;
  }
  .prose h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500; font-size: 24px; color: #14181d; margin: 34px 0 10px;
  }
  .prose p {
    font-size: 17px; line-height: 1.85; color: #44474b;
    font-weight: 300; margin: 0 0 24px;
  }
  .prose ul, .prose ol { margin: 0 0 24px; padding-left: 22px; }
  .prose li {
    font-size: 17px; line-height: 1.85; color: #44474b;
    font-weight: 300; margin-bottom: 8px;
  }
  .prose a { color: #002349; border-bottom: 1px solid #002349; }
  .prose img { width: 100%; height: auto; display: block; margin: 40px 0; }
  .prose blockquote {
    margin: 36px 0; padding-left: 24px; border-left: 2px solid #002349;
    font-family: 'Cormorant Garamond', serif; font-size: 24px;
    line-height: 1.5; font-style: italic; color: #24272b;
  }
  .prose strong { font-weight: 500; color: #14181d; }
</style>
